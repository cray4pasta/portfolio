<!DOCTYPE html>
<html lang="en">
<head>
    <script type="text/javascript">
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "wpp7kemq95");
    </script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Goody Hearts Club — Prerna Kashyap | Product Designer</title>
  <meta name="description" content="Lowering the barrier to social impact for art hobbyists through a joyful, friction-free platform.">
  <meta name="keywords" content="product designer, UX designer, Prerna Kashyap, Goody Hearts Club, case study, design system">
  <meta name="author" content="Prerna Kashyap">

  <meta property="og:type" content="website">
  <meta property="og:url" content="https://prernakashyap.com/goodyhearts.html">
  <meta property="og:title" content="Goody Hearts Club — Prerna Kashyap | Product Designer">
  <meta property="og:description" content="Lowering the barrier to social impact for art hobbyists through a joyful, friction-free platform.">
  <meta property="og:image" content="https://prernakashyap.com/assets/og-image.png">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Goody Hearts Club — Prerna Kashyap | Product Designer">
  <meta name="twitter:description" content="Lowering the barrier to social impact for art hobbyists through a joyful, friction-free platform.">
  <meta name="twitter:image" content="https://prernakashyap.com/assets/og-image.png">

  <link rel="icon" href="assets/favicon.png" type="image/png">
  <link rel="apple-touch-icon" href="assets/favicon.png">
  <link rel="stylesheet" href="assets/shared.css">

  <script async src="https://www.googletagmanager.com/gtag/js?id=G-X8PC6EMSNX"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-X8PC6EMSNX');
