  <style>
    /* ─── FIGMA REDESIGN TOKENS ───
       Page-scoped; overrides shared.css's .cs-v2 typography defaults for
       this page only (loaded after shared.css, so these win the cascade). */
    :root {
      --gh-primary: #2a2a2b;
      --gh-body: #575757;
      --gh-label: #b8b8b8;
      --gh-card: #f6f6f6;
      --gh-frame: #f3f3f3;
      --gh-frame-border: #dddddd;
      --gh-red-bg: #fef5f4;
      --gh-red-border: #e50000;
      --gh-green-bg: rgba(209,223,214,0.2);
      --gh-green-border: #1b6134;
    }

    /* ─── SIDEBAR CARDS ─── */
    .sidebar { gap: 20px; }
    .side-card {
      background: var(--gh-card);
      border-radius: 12px;
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      width: 100%;
    }
    .hero-text {
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 38px;
      line-height: 44px;
      color: var(--gh-primary);
      text-wrap: balance;
    }
    .hero-text em { font-style: normal; font-weight: 600; }
    .hero-subtext {
      font-family: var(--font-sans);
      font-weight: 400;
      font-size: 16px;
      line-height: 24px;
      color: var(--gh-body);
    }
    .cs-context { gap: 20px; margin-top: 0; }
    .cs-context-meta { grid-template-columns: 1fr 1fr; row-gap: 20px; column-gap: 60px; }
    .cs-context-row { gap: 4px; }
    .cs-context-label { color: var(--gh-body); font-size: 14px; font-weight: 400; }
    .cs-context-value { color: var(--gh-primary); font-size: 14px; font-weight: 400; }
    .sidebar-divider { display: none; }
    .cs-context-nav { gap: 4px; }
    .cs-context-link { color: var(--gh-body); font-size: 14px; }
    .cs-context-link:hover, .cs-context-link.active { color: var(--gh-primary); }

    /* ─── HERO IMAGE ───
       .cs-v2 prefix matches shared.css's specificity so these win the cascade. */
    .cs-v2 .hero-img {
      width: 100%;
      height: 460px;
      border-radius: 12px;
      margin-bottom: 0;
      overflow: hidden;
    }
    .hero-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 20%;
      display: block;
      pointer-events: none;
      transform: scale(1.15);
    }
    .next-project-link {
      display: flex;
      align-items: center;
      gap: 8px;
      width: 100%;
      padding: 24px 0;
      border-bottom: 1px solid var(--border);
      font-family: var(--font-sans);
      font-size: 20px;
      font-weight: 400;
      color: var(--gh-primary);
      text-decoration: none;
    }
    .next-project-link::before {
      content: '';
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--gh-label);
      flex-shrink: 0;
    }
    .next-project-link:hover { color: var(--gh-body); }

    /* ─── INNER CONTENT ─── */
    .cs-content {
      display: flex;
      flex-direction: column;
      gap: 120px;
      width: 100%;
      min-width: 0;
    }

    /* ─── SECTION BREAK ───
       .cs-v2 prefix matches shared.css's specificity so these win the cascade
       (shared.css's version adds a border-bottom divider we don't want here). */
    .cs-v2 .section-break {
      display: flex;
      flex-direction: column;
      gap: 20px;
      width: 100%;
      min-width: 0;
      padding: 0;
      border-bottom: none;
    }
    .section-header {
      display: flex;
      flex-direction: column;
      gap: 8px;
      width: 100%;
    }

    /* ─── TYPOGRAPHY OVERRIDES (Figma tokens) ─── */
    .cs-v2 .label { color: var(--gh-label); font-weight: 400; }
    .cs-v2 .section-heading { font-weight: 600; color: var(--gh-primary); letter-spacing: 0; }
    .cs-v2 .section-body { font-weight: 400; color: var(--gh-body); }
    .body-text, .section-body { font-weight: 400; color: var(--gh-body); }

    /* ─── FRAME BOX (bordered #f3f3f3 media containers) ─── */
    .frame-box {
      background: var(--gh-frame);
      border: 1px solid var(--gh-frame-border);
      border-radius: 12px;
      overflow: hidden;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .frame-box img, .frame-box video { width: 100%; display: block; }
    .phone-bezel {
      border-radius: 32px;
      border: 4px solid #111213;
      display: inline-block;
    }
    .phone-bezel-inner {
      overflow: hidden;
      border-radius: 28px;
      width: 240px;
    }
    .phone-bezel-inner video { width: 240px; display: block; }

    /* ─── PHOTO PAIR (Impact section) ─── */
    .photo-pair { display: flex; gap: 21px; width: 100%; }
    .photo-pair figure { flex: 1; border-radius: 8px; overflow: hidden; height: 232px; }
    .photo-pair img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .caption {
      font-family: var(--font-sans);
      font-size: 14px;
      line-height: 20px;
      color: var(--gh-body);
      text-align: center;
      width: 100%;
    }

    /* ─── PROBLEM ICON CALLOUT ─── */
    .icon-row {
      display: flex;
      gap: 12px;
      align-items: flex-start;
      background: var(--gh-card);
      border-radius: 12px;
      padding: 20px;
      width: 100%;
    }
    .icon-row img { width: 36px; height: 36px; flex-shrink: 0; }
    .icon-row .icon-title {
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 16px;
      color: var(--gh-primary);
      margin-bottom: 8px;
    }
    .icon-row .icon-body {
      font-family: var(--font-sans);
      font-weight: 400;
      font-size: 16px;
      line-height: 24px;
      color: var(--gh-body);
    }

    /* ─── QUOTE GRID (2×2) ─── */
    .quote-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; width: 100%; }
    .quote-card {
      background: var(--gh-card);
      border-radius: 12px;
      padding: 20px;
      display: flex;
      gap: 12px;
      align-items: center;
    }
    .quote-card::before { content: ''; width: 2px; align-self: stretch; background: var(--gh-frame-border); flex-shrink: 0; }
    .quote-card p { font-family: var(--font-sans); font-size: 16px; line-height: 24px; color: var(--gh-body); }

    /* ─── CENTERED MEDIA (CA image) ─── */
    .ca-img { max-width: 610px; margin: 0 auto; border-radius: 8px; overflow: hidden; width: 100%; }
    .ca-img img { width: 100%; display: block; }

    /* ─── PIVOT CARDS (X / Check) ─── */
    .pivot-card { border-radius: 12px; padding: 20px; display: flex; gap: 12px; width: 100%; }
    .pivot-card.bad { background: var(--gh-red-bg); border: 1px solid var(--gh-red-border); }
    .pivot-card.good { background: var(--gh-green-bg); border: 1px solid var(--gh-green-border); }
    .pivot-card img { width: 24px; height: 24px; flex-shrink: 0; margin-top: 2px; }
    .pivot-card .t { font-family: var(--font-sans); font-weight: 600; font-size: 16px; color: var(--gh-body); margin-bottom: 8px; }
    .pivot-card .b { font-family: var(--font-sans); font-weight: 400; font-size: 16px; line-height: 24px; color: var(--gh-body); }

    /* ─── BEFORE/AFTER FLOW ─── */
    .flow-block { display: flex; flex-direction: column; gap: 12px; width: 100%; }
    .flow-label { font-family: var(--font-sans); font-weight: 600; font-size: 16px; color: var(--gh-primary); }
    .flow-row { display: flex; align-items: center; gap: 8px; }
    .flow-card {
      flex: 1;
      background: var(--gh-card);
      border: 1px solid var(--gh-frame-border);
      border-radius: 8px;
      padding: 24px 16px;
      text-align: center;
      font-family: var(--font-sans);
      font-size: 15px;
      line-height: 22px;
      color: var(--gh-body);
    }
    .flow-arrow { font-size: 18px; color: var(--gh-label); flex-shrink: 0; }

    /* ─── PLATFORM INSPIRATION GRID ─── */
    .insp-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px 24px; width: 100%; }
    .insp-group { display: flex; flex-direction: column; gap: 8px; }
    .insp-pair { display: flex; gap: 8px; }
    .insp-pair img { flex: 1; border-radius: 8px; width: 100%; height: 260px; object-fit: cover; }
    .insp-name { font-family: var(--font-sans); font-size: 14px; color: var(--gh-body); text-align: center; }

    /* ─── NUMBERED CALLOUTS ─── */
    .numbered { display: flex; gap: 12px; width: 100%; }
    .numbered .n { font-family: var(--font-sans); font-weight: 600; font-size: 16px; color: var(--gh-primary); flex-shrink: 0; }
    .numbered .c { display: flex; flex-direction: column; gap: 12px; }
    .numbered .t { font-family: var(--font-sans); font-weight: 600; font-size: 16px; color: var(--gh-primary); }
    .numbered .b { font-family: var(--font-sans); font-weight: 400; font-size: 16px; line-height: 24px; color: var(--gh-body); }

    /* ─── PRINCIPLE CARDS ─── */
    .principles-row { display: flex; gap: 24px; align-items: stretch; width: 100%; }
    .principle-card {
      background: var(--gh-card);
      border: 1px solid var(--gh-frame-border);
      border-radius: 8px;
      flex: 1;
      min-height: 96px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 12px 20px;
      transition: background 0.25s ease, transform 0.25s ease;
    }
    .principle-card:hover { background: #efefef; transform: translateY(-4px); }
    .principle-text { font-family: var(--font-sans); font-size: 16px; line-height: 24px; color: var(--gh-primary); width: 100%; }

    /* ─── ACTION CARDS (Observation / Insight / Action) ─── */
    .action-row { display: flex; gap: 8px; width: 100%; }
    .action-card {
      flex: 1;
      background: var(--gh-card);
      border: 1px solid var(--gh-frame-border);
      border-radius: 8px;
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      transition: background 0.25s ease, transform 0.25s ease;
    }
    .action-card:hover { background: #efefef; transform: translateY(-4px); }
    .action-card .k { font-family: var(--font-sans); font-size: 14px; color: var(--gh-body); }
    .action-card .t { font-family: var(--font-sans); font-weight: 600; font-size: 16px; color: var(--gh-primary); }
    .action-card .b { font-family: var(--font-sans); font-weight: 400; font-size: 16px; line-height: 24px; color: var(--gh-body); }

    /* ─── STACKED ITERATION FRAMES ─── */
    .stack-frames { display: flex; flex-direction: column; gap: 12px; width: 100%; }
    .stack-frames img {
      width: 100%;
      border-radius: 12px;
      border: 1px solid var(--gh-frame-border);
      display: block;
    }

    /* ─── USABILITY TESTING PANELS ─── */
    .ut-pair { display: flex; flex-direction: column; gap: 12px; width: 100%; }
    .ut-pair img { width: 100%; border-radius: 8px; border: 1px solid var(--gh-frame-border); display: block; }

    /* ─── REFLECTION ─── */
    .reflection-section {
      display: flex;
      flex-direction: column;
      gap: 32px;
      width: 100%;
    }
    .reflection-block {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .reflection-heading {
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 24px;
      line-height: 30px;
      color: var(--gh-primary);
      width: 100%;
    }
    .reflection-body {
      font-family: var(--font-sans);
      font-weight: 400;
      font-size: 16px;
      line-height: 24px;
      color: var(--gh-body);
    }

    /* ─── RESPONSIVE ─── */
    @media (max-width: 900px) {
      .cs-v2 .hero-img { width: 100%; height: 320px; }
      .photo-pair { flex-direction: column; }
      .photo-pair figure { height: 220px; }
      .insp-grid { grid-template-columns: 1fr; }
      .quote-grid { grid-template-columns: 1fr; }
      .flow-row { flex-direction: column; }
      .flow-arrow { transform: rotate(90deg); }
      .action-row { flex-direction: column; }
      .principles-row { flex-direction: column; }
    }

    @media (max-width: 768px) {
      .nav-links { gap: 16px; }
      .nav-clock { display: none; }

      .cs-content { gap: 80px; }
      .cs-v2 .section-break { gap: 16px; }
      .reflection-heading { font-size: 22px; line-height: 28px; }
      .body-text { font-size: 16px; }
      .side-card { padding: 16px; }
      .hero-text { font-size: 26px; line-height: 32px; }

      * { cursor: auto !important; }
    }

    @media (max-width: 480px) {
      .cs-v2 .hero-img { height: 200px; }
    }

    @media (max-width: 550px) {
      .cs-main [style*="grid-template-columns"] {
        grid-template-columns: 1fr !important;
      }
      .cs-main, .cs-main * {
        max-width: 100% !important;
      }
      .cs-main img, .cs-main video {
        height: auto !important;
      }
      nav { padding: 0 20px; }
      .nav-links { gap: 12px; }
      .nav-links a { padding: 0 2px; }
    }

    /* ─── CAROUSEL ARROWS ─── */
    .carousel-arrow {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      border: 1px solid var(--border);
      background: var(--bg);
      font-size: 18px;
      color: var(--text);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: background 0.2s ease, transform 0.2s ease;
      cursor: none !important;
    }
    .carousel-arrow:hover {
      background: #f5f3f6;
      transform: scale(1.05);
    }

    /* ─── LIGHTBOX ─── */
    #lightbox {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.82);
      z-index: 9998;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s ease;
    }
    #lightbox.active {
      opacity: 1;
      pointer-events: all;
    }
    #lightbox img {
      max-width: 90vw;
      max-height: 90vh;
      object-fit: contain;
      border-radius: 8px;
      transform: scale(0.95);
      transition: transform 0.25s ease;
      cursor: none !important;
    }
    #lightbox.active img,
    #lightbox.active video { transform: scale(1); }
    #lightbox video {
      max-width: 90vw;
      max-height: 90vh;
      border-radius: 8px;
      transform: scale(0.95);
      transition: transform 0.25s ease;
      cursor: none !important;
      display: none;
    }
    #lightbox.video-mode img { display: none; }
    #lightbox.video-mode video { display: block; }
    .lb-zoom { cursor: none !important; pointer-events: auto !important; position: relative; z-index: 1; }
  </style>
</head>
<body class="cs-v2">

  <!-- NAV -->
  <div data-component="nav" data-variant="home"></div>
  <script src="assets/nav.js"></script>

  <!-- LAYOUT -->
  <div class="page-layout">

    <!-- SIDEBAR -->
    <aside class="sidebar">
      <div class="side-card">
        <h1 class="hero-text">Helping artists contribute to social impact</h1>
        <p class="hero-subtext">There was a gap in the market for artists to easily contribute to social impact.</p>
        <p class="hero-subtext">I led the design of a 0 to 1 product for a community-driven platform, focusing on the onboarding experience for artists, to reduce vulnerability and increase participation.</p>
      </div>

      <div class="side-card">
        <div class="cs-context-meta">
          <div class="cs-context-row">
            <span class="cs-context-label">Role</span>
            <span class="cs-context-value">Product Designer</span>
          </div>
          <div class="cs-context-row">
            <span class="cs-context-label">Team</span>
            <span class="cs-context-value">1 Product Designer, 1 PM, 1 Product Engineer, 2 UX Researchers</span>
          </div>
          <div class="cs-context-row">
            <span class="cs-context-label">Timeline</span>
            <span class="cs-context-value">Feb 26' – May 26'</span>
          </div>
          <div class="cs-context-row">
            <span class="cs-context-label">Build</span>
            <span class="cs-context-value">Designed and shipped completely using AI</span>
          </div>
        </div>
      </div>

      <div class="side-card">
        <div class="cs-context-nav">
          <a class="cs-context-link" href="#section-impact">Context</a>
          <a class="cs-context-link" href="#section-problem">Problem</a>
          <a class="cs-context-link" href="#section-design">Design</a>
          <a class="cs-context-link" href="#section-reflection">Reflection</a>
        </div>
      </div>
    </aside>

    <!-- MAIN CONTENT -->
    <div class="main-col">
     <div class="cs-main">
      <div class="hero-img">
        <img src="assets/Goody Hearts Hero.png" alt="Goody Hearts Club — product hero">
      </div>

      <div class="cs-content">

        <!-- IMPACT -->
        <div class="section-break" id="section-impact">
          <div class="section-header">
            <p class="label">Impact</p>
            <p class="section-heading">We raised 150 trees within 2 weeks of our launch, completely selling out and received over 20 art submissions.</p>
          </div>
          <div class="photo-pair">
            <figure><img src="assets/Booth 1.png" alt="First physical booth, photo 1" class="lb-zoom"></figure>
            <figure><img src="assets/Booth 2.png" alt="First physical booth, photo 2" class="lb-zoom"></figure>
          </div>
          <p class="caption">Pictures from our first physical booth!</p>
        </div>

        <!-- RESEARCH / HOMEPAGE RESULT -->
        <div class="section-break">
          <div class="section-header">
            <p class="section-heading">An experience built around how artists think and feel</p>
          </div>
          <div class="frame-box" style="height:465px;">
            <div class="phone-bezel">
              <div class="phone-bezel-inner">
                <video autoplay muted loop playsinline class="lb-zoom">
                  <source src="assets/goodyhearts-result.mov" type="video/mp4">
                </video>
              </div>
            </div>
          </div>
        </div>

        <!-- PROBLEM -->
        <div class="section-break" id="section-problem">
          <div class="section-header">
            <p class="label">Problem</p>
            <p class="section-heading">Artists want to use their creativity for social good but currently there is no clear pathway for them to do that.</p>
          </div>
          <div class="icon-row">
            <img src="assets/Problem icon.png" alt="">
            <div>
              <p class="icon-title">Artists feel like their art is not good enough to matter.</p>
              <p class="icon-body">To understand the drivers and barriers for artist participation we conducted a user survey to explore their interests, behaviors, and past experiences. Through the 32 survey responses we received, we grouped the responses based on the common feelings of artists we could identify and came up with these 4 insights.</p>
            </div>
          </div>
          <div class="quote-grid">
            <div class="quote-card"><p>I am not sure how much of an impact my art would have.</p></div>
            <div class="quote-card"><p>I don't think my art is very good, not sure if others would be interested.</p></div>
            <div class="quote-card"><p>I don't think my art is serious enough for something so important. I create for fun.</p></div>
            <div class="quote-card"><p>I create art to make my activities more enjoyable.</p></div>
          </div>
        </div>

        <!-- MARKET RESEARCH -->
        <div class="section-break">
          <div class="section-header">
            <p class="label">Market research</p>
            <p class="section-heading">Every existing platform in the market felt either like a competition or unpaid freelance work.</p>
            <p class="section-body">I wanted to understand what current platforms are doing to solve this problem and evaluate their onboarding flows to see if they alienate artists. I used Perplexity AI to run a competitive analysis.</p>
          </div>
          <div class="ca-img"><img src="assets/CA img 1.png" alt="Competitive analysis" class="lb-zoom"></div>
        </div>

        <!-- HMW / PIVOT -->
        <div class="section-break">
          <div class="section-header">
            <p class="section-heading">How might we support art hobbyists to easily participate in social impact work through their creative practice?</p>
          </div>

          <div class="pivot-card bad">
            <img src="assets/Icon x.png" alt="">
            <div>
              <p class="t">What if we create a platform where artists can feature their art as stickers for a certain fee, which directly funds social impact?</p>
              <p class="b">But attaching money to art, especially for a new platform, would have created the same friction and feeling of unpaid freelance work. I knew that people are far less likely to act when there's no established relationship yet. We had no proof or credibility, no reason for an artist to pay and also create art when they could just donate directly.</p>
            </div>
          </div>
          <div class="pivot-card good">
            <img src="assets/Icon check.png" alt="">
            <p class="t" style="margin:0;">I proposed flipping the model, free submissions for artists and everyone can purchase the stickers.</p>
          </div>

          <div class="flow-block">
            <p class="flow-label">Before</p>
            <div class="flow-row">
              <div class="flow-card">Artists pay to submit art work</div>
              <span class="flow-arrow">&rarr;</span>
              <div class="flow-card">Funds go to social cause</div>
              <span class="flow-arrow">&rarr;</span>
              <div class="flow-card">Stickers distributed for free</div>
            </div>
          </div>
          <div class="flow-block">
            <p class="flow-label">After</p>
            <div class="flow-row">
              <div class="flow-card">Artists submit art work for free</div>
              <span class="flow-arrow">&rarr;</span>
              <div class="flow-card">Profit funds social cause</div>
              <span class="flow-arrow">&rarr;</span>
              <div class="flow-card">Everyone can buy stickers</div>
            </div>
          </div>
        </div>

        <!-- IDEATION -->
        <div class="section-break" id="section-ideation">
          <div class="section-header">
            <p class="label">Ideation</p>
            <p class="section-heading">With the foundation set, I began exploring different submission flows to understand what the artists were already used to.</p>
            <p class="section-body">I looked at Ko-fi, Patreon, Pinterest, and Instagram — four platforms where artists share their work frequently to map what worked, what created friction, and what I needed to avoid.</p>
          </div>

          <div class="insp-grid">
            <div class="insp-group">
              <div class="insp-pair"><img src="assets/Pinterest 1.png" alt="" class="lb-zoom"><img src="assets/Pinterest 2.png" alt="" class="lb-zoom"></div>
              <p class="insp-name">Pinterest</p>
            </div>
            <div class="insp-group">
              <div class="insp-pair"><img src="assets/Instagram 1.png" alt="" class="lb-zoom"><img src="assets/Instagram 2.png" alt="" class="lb-zoom"></div>
              <p class="insp-name">Instagram</p>
            </div>
            <div class="insp-group">
              <div class="insp-pair"><img src="assets/Kofi 1.png" alt="" class="lb-zoom"><img src="assets/Kofi 2.png" alt="" class="lb-zoom"></div>
              <p class="insp-name">Ko-fi</p>
            </div>
            <div class="insp-group">
              <div class="insp-pair"><img src="assets/Patreon 1.png" alt="" class="lb-zoom"><img src="assets/Patreon 2.png" alt="" class="lb-zoom"></div>
              <p class="insp-name">Patreon</p>
            </div>
          </div>

          <div class="numbered">
            <span class="n">01</span>
            <div class="c">
              <p class="t">Pinterest, Ko-fi, and Patreon all require signups before you can share or submit anything.</p>
              <p class="b">I wanted the platform to be low commitment. Artists should be able to contribute to social impact without having to download a new app or sign up for emails from one more platform.</p>
            </div>
          </div>
          <div class="numbered">
            <span class="n">02</span>
            <div class="c">
              <p class="t">Artists measure their work's worth by engagement or the amount of likes and saves, which most times takes the joy out of creating.</p>
              <p class="b">A lot of platforms make sharing art into a competition — the best work gets picked and is used by non-profits, but art is subjective and everyone who wants to contribute should be able to.</p>
            </div>
          </div>
        </div>

        <!-- DESIGN PRINCIPLES -->
        <div class="section-break">
          <div class="section-header">
            <p class="label">Design Principles</p>
            <p class="section-heading">Principles that guided my design</p>
            <p class="section-body">Based on the findings from research and my own exploration, I developed these three design principles to inform my design decisions.</p>
          </div>
          <div class="principles-row">
            <div class="principle-card"><p class="principle-text">Design for emotional safety and joy</p></div>
            <div class="principle-card"><p class="principle-text">Focus on belonging over participating</p></div>
            <div class="principle-card"><p class="principle-text">Reassure users that their contribution matters</p></div>
          </div>
        </div>

        <!-- DESIGN 01 -->
        <div class="section-break" id="section-design">
          <div class="section-header">
            <p class="label">Design 01</p>
            <p class="section-heading">Reducing Decisional Friction</p>
          </div>
          <div class="action-row">
            <div class="action-card">
              <span class="k">Observation</span>
              <span class="t">Artists hate choosing their own work</span>
              <span class="b">Pre-launch, almost every artist sent multiple doodles and wanted us to choose what to sell.</span>
            </div>
            <div class="action-card">
              <span class="k">Insight</span>
              <span class="t">Choosing triggers perfectionism.</span>
              <span class="b">Forcing one upload makes artists judge their own work, which might trigger decision anxiety.</span>
            </div>
            <div class="action-card">
              <span class="k">Action</span>
              <span class="t">Multi-photo upload</span>
              <span class="b">Artists should be allowed to upload up to 5 photos so they don't have to pick their "best" work.</span>
            </div>
          </div>
          <div class="stack-frames">
            <img src="assets/Iteration final.png" alt="Final iteration — multi-photo submission screen" class="lb-zoom">
            <img src="assets/Iteration 1.png" alt="Iteration 1 — submission screen" class="lb-zoom">
            <img src="assets/Iteration 2.png" alt="Iteration 2 — submission screen" class="lb-zoom">
          </div>
        </div>

        <!-- DESIGN 02 -->
        <div class="section-break">
          <div class="section-header">
            <p class="label">Design 02</p>
            <p class="section-heading">Designing for joy to reduce anxiety and emphasize the submission value.</p>
            <p class="section-body">The animation acts as a direct metaphor for the artist's impact on the social cause because without their art there would be no stickers to plant trees.</p>
          </div>
          <div class="frame-box" style="height:503px;">
            <div style="overflow:hidden;border-radius:40px;width:240px;height:503px;">
              <video autoplay muted loop playsinline style="width:240px;height:503px;object-fit:cover;display:block;" class="lb-zoom">
                <source src="assets/joy animation.mov" type="video/mp4">
              </video>
            </div>
          </div>
        </div>

        <!-- DESIGN 03 -->
        <div class="section-break">
          <div class="section-header">
            <p class="label">Design 03</p>
            <p class="section-heading">Reducing input fatigue and errors</p>
            <p class="section-body">To reduce input fatigue, the email field automatically populates the moment a user types @. I also designed an interactive circular crop tool directly within the preview, allowing artists to scale and position their design with real-time visual proofing.</p>
          </div>
          <img src="assets/small things.png" alt="Small details — autofill email, error prevention, real-time crop preview" style="width:100%;border-radius:12px;border:1px solid var(--gh-frame-border);display:block;" class="lb-zoom">
        </div>

        <!-- USABILITY TESTING -->
        <div class="section-break" id="section-testing">
          <div class="section-header">
            <p class="label">Usability Testing</p>
            <p class="section-heading">Validating User Confidence, Reassurance, and Perceived Clarity.</p>
            <p class="section-body">To understand if there was a gap between my design intentions and real user perceptions, I ran 5 usability tests focusing on the emotional and cognitive experience of the artists. I wanted to understand how users felt navigating the platform.</p>
          </div>

          <div class="numbered">
            <span class="n">01</span>
            <div class="c">
              <p class="t">Participants repeatedly tried clicking on existing community stickers in the gallery.</p>
              <p class="b">This behavior made me realize that people want to connect with the art and understand the story behind the design.</p>
            </div>
          </div>
          <div class="ut-pair">
            <img src="assets/UT redesign 1.png" alt="Usability test — gallery interactivity" class="lb-zoom">
            <img src="assets/UT redesign 2.png" alt="Usability test — optional artist story field" class="lb-zoom">
          </div>

          <div class="numbered">
            <span class="n">02</span>
            <div class="c">
              <p class="t">Do I need to add more drawings?</p>
              <p class="b">The empty placeholder slots on the personal details screen caused confusion. Instead of making it easier to add more art, it made participants feel like they had made a mistake or needed to upload more artwork.</p>
            </div>
          </div>
          <img src="assets/UT redesign 3.png" alt="Usability test — before/after confirmation screen" style="width:100%;border-radius:8px;border:1px solid var(--gh-frame-border);display:block;" class="lb-zoom">
        </div>

        <!-- AI EXPERIMENTS -->
        <div class="section-break" id="section-ai">
          <div class="section-header">
            <p class="label">AI Experiments</p>
            <p class="section-heading">Claude can you build a UX copy?</p>
            <p class="section-body">To ensure the tone remained consistently empathetic, clear, and reassuring across every touchpoint of the experience, I used Claude to build a comprehensive UX Copy Documentation framework.</p>
          </div>
          <img src="assets/ux copy.png" alt="UX copy documentation" style="width:100%;border-radius:8px;border:1px solid var(--gh-frame-border);display:block;" class="lb-zoom">
        </div>

        <!-- REFLECTION -->
        <div class="reflection-section" id="section-reflection">
          <div class="reflection-block">
            <p class="reflection-heading">Working with AI requires a LOT of patience</p>
            <p class="reflection-body">Because we had to design and launch this product on a brutally fast timeline, I initially turned to Claude to create wireframes which led to generic outputs. What did work was using it as a design review partner because AI is really good at catching patterns/auditing. It taught me that you have to constantly experiment with AI workflows to figure out what actually accelerates your unique process and what just hinders it.</p>
          </div>
          <div class="reflection-block">
            <p class="reflection-heading">Human connection is essential</p>
            <p class="reflection-body">Stepping away from the screen to watch real people interact with our product was such an amazing experience. Seeing them connect with the non-profit's cause and buy the stickers filled me with so much joy. It reminded me that we are building tools that impact real human communities.</p>
          </div>
        </div>

        <a href="linkedin.html" class="next-project-link">Next Project: Reimagining LinkedIn &rarr;</a>

      </div><!-- /cs-content -->
     </div><!-- /cs-main -->
    </div><!-- /main-col -->
  </div><!-- /page-layout -->

  <div id="lightbox">
    <img id="lb-img" src="" alt="">
    <video id="lb-video" controls playsinline></video>
  </div>
  <div id="cursor"><img src="assets/custom cursor.svg" alt=""></div>

  <script>
    const cursor = document.getElementById('cursor');
    let raf;
    document.addEventListener('mousemove', (e) => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        cursor.style.left = e.clientX + 'px';
        cursor.style.top  = e.clientY + 'px';
      });
    });

    // TOC scroll-spy
    (function(){
      var sections = ['section-impact','section-problem','section-design','section-reflection'];
      var links = document.querySelectorAll('.cs-context-link');
      function onScroll(){
        var scrollY = window.scrollY + 160;
        var current = sections[0];
        sections.forEach(function(id){
          var el = document.getElementById(id);
          if(el && el.offsetTop <= scrollY) current = id;
        });
        links.forEach(function(l){
          l.classList.toggle('active', l.getAttribute('href') === '#' + current);
        });
      }
      window.addEventListener('scroll', onScroll, {passive:true});
      onScroll();
    })();

    // Lightbox
    (() => {
      const lb    = document.getElementById('lightbox');
      const lbImg = document.getElementById('lb-img');
      const lbVid = document.getElementById('lb-video');

      function closeLb() {
        lb.classList.remove('active', 'video-mode');
        lbVid.pause();
        lbVid.removeAttribute('src');
      }

      document.addEventListener('click', e => {
        const img = e.target.closest('img.lb-zoom');
        const vid = e.target.closest('video.lb-zoom');

        if (img) {
          lb.classList.remove('video-mode');
          lbImg.src = img.src;
          lbImg.alt = img.alt;
          lb.classList.add('active');
          return;
        }

        if (vid) {
          const src = vid.querySelector('source')?.src || vid.src;
          lbVid.src = src;
          lbVid.play();
          lb.classList.add('active', 'video-mode');
          return;
        }

        if (e.target.closest('#lightbox')) closeLb();
      });

      document.addEventListener('keydown', e => { if (e.key === 'Escape') closeLb(); });
    })();
  </script>

<script src="assets/cursor-trail.js"></script>
</body>
</html>
